name = input("Enter student name: ")
marks = []

for i in range(1, 6):
    mark = int(input(f"Enter subject {i} marks: "))
    marks.append(mark)

total = sum(marks)
percentage = total / 5

print("Student Name:", name)
print("Total Marks:", total)
print("Percentage:", percentage, "%")

if all(0 <= mark <= 100 for mark in marks):
    if percentage >= 75:
        print("Grade: A")
    elif percentage >= 60:
        print("Grade: B")
    elif percentage >= 40:
        print("Grade: C")
    else:
        print("Result: Fail")
else:
    print("Invalid marks")
